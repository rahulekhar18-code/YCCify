{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": [
      "dom",
      "esnext"
    ],
    "allowJs": true,
    "jsx": "react-native",
    "noEmit": true,
    "strict": false,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@yccify/types": [
        "../../packages/types/src"
      ],
      "@yccify/api": [
        "../../packages/api/src"
      ]
    }
  },
  "include": [
    "src/**/*",
    "App.tsx"
  ]
}